{
  "name": "nestjs-twelve-factor",
  "version": "1.0.0",
  "description": "NestJS microservice following 12-Factor App methodology",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "console": "nest start --entryFile repl",
    "migration:generate": "typeorm migration:generate -d dist/typeorm.config.js",
    "migration:run": "typeorm migration:run -d dist/typeorm.config.js",
    "migration:revert": "typeorm migration:revert -d dist/typeorm.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.0",
    "nestjs-pino": "^3.5.0",
    "pg": "^8.11.0",
    "pino-http": "^8.5.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "^20.0.0",
    "pino-pretty": "^10.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
